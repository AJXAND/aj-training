  "Trip week: one short session, none on riding days",
  "Freestyle: trampoline and airbag time is skill work"
 ],
 "primer": [
  "Easy jog or bike 5-8 min",
  "Hip and ankle mobility",
  "2-3 x 2-3 box jumps or jump turns to stick",
  "Wrist circles and forearm warm-up"
 ],
 "taper": {
  "days": 5,
  "lines": [
   "Last hard session 4-5 days before a trip or contest",
   "No heavy legs within 48 h of competing",
   "Cut volume by about half, keep the load",
   "No new exercises in the last 2 weeks"
  ]
 },
 "rules": [
  "Wear wrist guards and a helmet, especially while learning",
