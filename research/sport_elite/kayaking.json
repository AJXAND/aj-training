 "week": [
  "No heavy upper body before quality water sessions.",
  "No upper gym the day before a race.",
  "Lift after paddling, or with 6 h between.",
  "Marathon: 2 sessions a week, 1 in season."
 ],
 "primer": [
  "2-3 x 3 med ball throws",
  "One lift 2 x 2 at about 80%",
  "Once, 3-4 days before the race"
 ],
 "taper": {
  "days": 12,
  "lines": [
   "Water volume down 40-60% over 10-14 days.",
   "Last heavy lift 7-10 days out.",
   "One primer 3-4 days out.",
   "No new exercises in the final 2 weeks."
  ]
 },
 "rules": [
  "Rotator cuff and scapular work 2-3 times a week, all year.",
  "Pulling sets at least equal to pressing sets.",
  "Avoid sudden jumps in paddling volume (shoulder and wrist).",
  "Wrist or forearm pain: check paddle feather and grip, refer if it lasts."
 ],
