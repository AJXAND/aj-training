 "tests": [
  {
   "id": "cmj",
   "name": "Countermovement jump",
   "how": "Hands on hips, jump mat or phone app, best of 3.",
   "unit": "cm",
   "better": "higher",
   "bands": {
    "club": "40",
    "good": "48",
    "elite": ">55"
   },
   "note": "Men shown. Women: 30 / 35 / >40."
  },
  {
   "id": "spikejump",
   "name": "Spike jump height gain",
   "how": "Approach jump: jump reach minus standing reach, best of 3.",
   "unit": "cm",
   "better": "higher",
   "bands": {
    "club": "65",
    "good": "75",
    "elite": ">85"
   },
   "note": "Men shown. Women: 45 / 52 / >58."
  },
  {
   "id": "ttest",
   "name": "T-test (agility)",
   "how": "Sprint 10 m, shuffle 5 m left, 10 m right, 5 m left, backpedal 10 m.",
   "unit": "s",
   "better": "lower",
   "bands": {
    "club": "10.5",
    "good": "10.0",
    "elite": "<9.6"
   },
   "note": "Men shown. Women: 11.5 / 11.0 / <10.5."
  },
  {
   "id": "squat1rm",
   "name": "Squat estimated 1RM",
   "how": "3-5RM, convert to 1RM, divide by body mass.",
   "unit": "x body mass",
   "better": "higher",
   "bands": {
    "club": "1.25",
    "good": "1.5",
    "elite": "1.75"
   },
   "note": "Men shown. Women: 1.0 / 1.25 / 1.5."
  }
 ],
 "week": [
  "Gym A (lower) at least 72 h before a match.",
  "Gym B (upper and shoulder) MD-2, no jumps.",
  "In season, gym jumps are 2-3 sets of 3 max efforts only.",
  "Weekend double-headers: MD+2 maintenance only."
 ],
 "primer": [
  "2 x 3 max-effort jumps.",
  "Shoulder ER and scapular warm-up.",
  "Ankle balance 30 s per side."
 ],
 "taper": {
  "days": 7,
  "lines": [
   "Last heavy lower MD-5 with half the sets.",
   "Cut practice jump volume by 30-50% in the last week.",
   "Primers only after that."
  ]
 },
 "rules": [
  "Previous ankle sprain: prompt to brace or tape for play.",
  "In season, no more than 20 plyo contacts per gym session.",
  "Watch weekly jump counts; avoid doubling them week to week.",
  "Shoulder ER:IR strength ratio under 0.66 means more cuff work.",
  "Female players: landing module 2-3 times a week, all year."
 ],
