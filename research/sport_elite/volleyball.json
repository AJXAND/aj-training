  {
   "id": "middle",
   "name": "Middle blocker",
   "desc": "Most jumps per minute on court: block jumps and quick attacks load the patellar tendon.",
   "q": {
    "power": 3
   },
   "prehab": [
    "patellar",
    "ankle"
   ],
   "note": "Block jumps from a shuffle, lateral footwork and Spanish squats every lower day."
  },
  {
   "id": "outside",
   "name": "Outside hitter / opposite",
   "desc": "Highest-intensity spikes and jump serves: very high shoulder load.",
   "q": {
    "rotational": 3
   },
   "prehab": [
    "shoulderER",
    "patellar"
   ],
   "note": "Shoulder module comes first; adds rotational med ball work."
  },
  {
   "id": "setter",
   "name": "Setter",
   "desc": "Most jumps, but low ones, plus overhead hand work.",
   "q": {},
   "prehab": [
    "ankle",
    "fingers",
    "patellar"
   ],
   "note": "Adds finger and ankle care; jump power stays submaximal."
  },
  {
   "id": "libero",
   "name": "Libero",
   "desc": "No attacking jumps: digging, lateral movement and low squats.",
   "q": {
    "power": 2
   },
   "prehab": [
    "ankle",
    "hipAbd",
    "lowback"
   ],
   "note": "Drops approach jumps, adds lateral lunges, deep squat mobility and more ankle work."
  },
  {
   "id": "beach",
   "name": "Beach",
   "desc": "Pairs on sand: more jumps and lateral work per player, lower jumps, heat; sand loads calves and hips more.",
   "q": {
    "unilateral": 3
   },
   "prehab": [
    "calf",
    "ankle",
    "shoulderER"
   ],
   "note": "More calf and hip work, sand intervals, and summer tournaments with several matches a day."
  }
