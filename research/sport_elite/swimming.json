 "tests": [
  {
   "id": "cmj",
   "name": "Countermovement jump",
   "how": "Jump mat or phone app, hands on hips, best of 3.",
   "unit": "cm",
   "better": "higher",
   "bands": {
    "club": "<45",
    "good": "45-55",
    "elite": ">55"
   },
   "note": "Competitive sprint men (coach practice). Women 35-42 cm. Distance: just track it."
  },
  {
   "id": "pullups",
   "name": "Max pull-ups",
   "how": "Dead hang start, chin over bar, no kip.",
   "unit": "reps",
   "better": "higher",
   "bands": {
    "club": "<12",
    "good": "12-15",
    "elite": "15+"
   },
   "note": "15 is the sprint target, 12 distance. Women about 8 sprint, 6 distance."
  },
  {
   "id": "squat1rm",
   "name": "Back squat 1RM",
   "how": "Estimate from a 3-5RM, never test to failure in taper.",
   "unit": "x bodyweight",
   "better": "higher",
   "bands": {
    "club": "<1.25",
    "good": "1.25-1.5",
    "elite": "1.5-1.75"
   },
   "note": "1.25 x is the distance target, 1.5-1.75 x sprint."
  },
  {
   "id": "erir",
   "name": "Shoulder ER:IR strength ratio",
   "how": "Handheld dynamometer at 90 degrees, or 5RM cable ER vs IR.",
   "unit": "ratio",
   "better": "higher",
   "bands": {
    "club": "<0.66",
    "good": "0.66+"
   },
   "note": "Low ratios are common in swimmers. Below about 0.66: more cuff work."
  },
  {
   "id": "start15",
   "name": "Start: time to 15 m",
   "how": "Dive start, video or coach stopwatch to the 15 m mark.",
   "unit": "s",
   "better": "lower",
   "bands": {},
   "note": "Track your own trend."
  }
 ],
 "week": [
  "Gym after a lighter swim, or the afternoon of a single-swim day.",
  "No heavy upper pulling before big pull sets or key quality swims.",
  "No upper-body gym the day before a race.",
  "Count lat and shoulder load across pool and gym together.",
  "Distance swimmers: 2 sessions, keep one heavy lower lift for turns and bone health."
 ],
 "primer": [
  "3 x 2 jumps",
  "3 x 3 med ball throws",
  "One lift 2 x 2 at about 80%",
  "Last one 3-5 days before the race"
 ],
 "taper": {
  "days": 21,
  "lines": [
   "Swim volume down 41-60% over 2-3 weeks, intensity kept.",
   "Sprinters: last heavy lift 7-10 days out.",
   "Distance: last heavy lift 10-14 days out.",
   "Then 1-2 short power sessions, ending 3-5 days out.",
   "Do not drop lifting for all 3 weeks: sprinters lose power.",
   "No new exercises in the final 2 weeks."
  ]
 },
 "rules": [
  "Rotator cuff and scapular work 2-3 times a week, all year.",
  "Pulling sets at least equal to pressing sets.",
  "Low-volume, heavy or fast lifting; no high-rep burnout sets.",
  "Shoulder pain that lasts: cut swim and pull volume, refer if it persists.",
  "No maxing within 10 days of a target race."
 ],
