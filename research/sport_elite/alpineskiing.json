  "tests": [
    {
      "id": "squat1rm",
      "name": "Back squat 1RM",
      "how": "Estimate from a 3-5 rep max with good depth",
      "unit": "x BM",
      "better": "higher",
      "bands": {
        "club": "<1.5",
        "good": "1.5-1.8",
        "elite": "1.8+"
      },
      "note": "Racer benchmarks; skip true maxes in season"
    },
    {
      "id": "cmj",
      "name": "Countermovement jump",
      "how": "Hands on hips, jump and reach or use a jump app; best of 3",
      "unit": "cm",
      "better": "higher",
      "bands": {
        "club": "<45",
        "good": "45+"
      },
      "note": "Good racer level; women 35 cm. No elite figure in our sources"
    },
    {
      "id": "latbox90",
      "name": "Lateral box jump, 90 s",
      "how": "Jump side to side over a low box for 90 s; count contacts",
      "unit": "reps",
      "better": "higher",
      "bands": {},
      "note": "Used in ski testing; track your own trend"
    },
    {
      "id": "hopsym",
      "name": "Single-leg hop symmetry",
      "how": "3 single-leg hops for distance each side; weaker / stronger x 100",
      "unit": "%",
      "better": "higher",
      "bands": {
        "club": "<90",
        "good": "90+"
      },
      "note": "Below 90% means work the weaker leg (coach practice)"
    },
    {
      "id": "wallsit",
      "name": "Wall sit at 90 degrees",
      "how": "Back flat on a wall, thighs level; hold to failure",
      "unit": "s",
      "better": "higher",
      "bands": {
        "club": "<120",
        "good": "120+"
      },
      "note": "Recreational target (coach practice)"
    }
  ],
  "week": [
    "Racers: May to Oct is the main strength block, 3 sessions a week",
    "On snow (Nov to Apr): 1-2 short sessions, heavy one mid-week",
    "Nothing heavy for the legs within 48 h of a race",
    "Recreational: 2-3 sessions a week for 6-8 weeks before a trip",
    "Trip week: one short session, none on ski days"
  ],
  "primer": [
    "Easy bike or jog 5-8 min",
    "Leg swings and lateral lunges",
    "2-3 x 2-3 lateral bounds to stick",
    "2 x 3 squat jumps, full rest"
  ],
  "taper": {
    "days": 5,
    "lines": [
      "Racers: keep one short heavy session mid-week",
      "No heavy legs within 48 h of a race",
      "Recreational: last hard session 4-5 days before you travel",
      "Cut volume by about half in the final week, keep the load",
      "No new exercises in the last 2 weeks"
    ]
  },
  "rules": [
    "Nordics all year: ramp up, then low-volume maintenance",
    "Stop skiing when your legs are tired; late-day fatigue drives knee injuries",
    "Get your bindings set by a ski shop for your weight and level",
    "Learn the knee-safe fall that protects the ACL (anterior cruciate ligament): arms forward, hands over skis, do not fight a fall back",
    "Release your poles when you fall (skier's thumb)",
    "Core strength is a priority, not an afterthought"
  ],
