  "group": "Snow",
  "variants": [
    {
      "id": "racer",
      "name": "Ski racer",
      "desc": "Runs of 45 s (slalom) to 2.5 min (downhill) with high eccentric and isometric leg loads and G-forces.",
      "q": {
        "mass": 2
      },
      "prehab": [
        "landing",
        "nordic"
      ],
      "note": "Your main strength block is the dry-land season (May to October). On snow you lift 1-2 times a week."
    },
    {
      "id": "recreational",
      "name": "Recreational skier",
      "desc": "Long days of repeated moderate eccentric work; fatigue late in the day drives injury.",
      "q": {
        "mass": 1
      },
      "prehab": [
        "landing",
        "hipAbd"
      ],
      "note": "Train 2-3 times a week for 6-8 weeks before your trip, then one short session the week you travel and none on ski days."
    }
  ],
