    "rest": "none",
    "intensity": "Pump no higher than 3/10",
    "perWeek": 2,
    "why": "Builds forearm aerobic capacity for routes."
   },
   {
    "name": "General aerobic",
    "mode": "any",
    "work": "30 min bike, run or row",
    "rest": "none",
    "intensity": "Easy",
    "perWeek": 1,
    "why": "Recovery and the base for long multi-pitch days."
   }
  ],
  "pre": [
   {
    "name": "Campus board (advanced only)",
    "mode": "any",
    "work": "4-6 sets of ladders or bumps",
    "rest": "3 min",
    "intensity": "Max speed; stop at any loss of speed",
    "perWeek": 1,
    "why": "Contact strength; only for adult V7/7b+ climbers with 2+ years of hangboarding."
   }
  ],
  "in": [
   {
    "name": "4 x 4s",
    "mode": "any",
    "work": "4 boulder problems back to back, 4 rounds",
