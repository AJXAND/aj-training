 "week": [
  "Priority: climbing quality, then fingers, then strength, then conditioning.",
  "Hangboard at the start of a climbing session after a full warm-up, or on its own.",
  "Never hangboard after a hard climbing session.",
  "Strength after an easy climb or on a rest day.",
  "No heavy pulling the day before a project or comp."
 ],
 "primer": [
  "10 min general warm-up",
  "5-8 progressive hangs on big edges at 30-80% effort",
  "A few hard moves, then stop"
 ],
 "taper": {
  "days": 7,
  "lines": [
   "Final hard finger session 5-7 days out.",
   "Last limit climbing 3-4 days out.",
   "Then 1-2 days of rest or easy movement.",
   "Final week volume about half; keep a few hard moves."
  ]
 },
 "rules": [
  "No hangboard under 16 years old (BMC guidance).",
  "No hangboard before about 18-24 months of regular climbing.",
  "Maximum 2 finger sessions a week, at least 48 h apart.",
  "Add no more than about 2-5% body mass (about 2 kg) a week.",
  "No campus board unless advanced: adult, V7/7b+, 2+ years hangboarding, no finger issues.",
  "Sharp finger pain stops the session.",
  "Never hangboard with cold or already tired fingers.",
  "Never full crimp under maximal load; no one-arm hangs below advanced.",
  "Finger blocks last 4-8 weeks.",
  "Under 16s: no intensive finger training and no campus board (growth plates).",
  "Rotator cuff and scapular work 2-3x a week.",
  "Do not chase low body mass: it raises RED-S risk."
 ],
