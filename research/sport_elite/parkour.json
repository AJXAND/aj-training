  "week": [
    "Heavy legs early in the week, not the day before a big jump session",
    "Upper body and grip on the day after a heavy jump session",
    "Never stack heavy landings in the gym and outdoors on the same day",
    "Competition or jam weekend: legs no later than 72 h before"
  ],
  "primer": [
    "8-10 min warm-up with real jumps and landings, not just stretching",
    "2 x 3 broad or box jumps",
    "1 set of wrist prep and band shoulder rotations",
    "Easy run-throughs of the line"
  ],
  "taper": {
    "days": 7,
    "lines": [
      "Last heavy leg session 5-7 days out",
      "Cut gym and drop-landing volume by about half",
      "Keep short, sharp jumps",
      "No new big moves in the last week"
    ]
  },
  "rules": [
    "Warm up with jumps and landings, not just light mobility",
    "Train jumps and landings on both legs",
    "Build drop height slowly; new athletes keep drops low",
    "Move to minimalist shoes gradually",
    "Never train big moves or heights alone",
    "Under 18: supervised, technique first, follow youth training guidance"
  ],
