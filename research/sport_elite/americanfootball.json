    "maxStrength": 2,
    "power": 3,
    "unilateral": 3,
    "mass": 1
   },
   "prehab": [
    "nordic",
    "landing"
   ],
   "note": "Your plan adds a weekly speed session and puts Nordics first."
  },
  {
   "id": "qb",
