  {
   "id": "bigs",
   "name": "Offensive and defensive linemen",
   "desc": "Collide on every snap: maximal strength, first-step power from a stance, hand-fighting and mass.",
   "q": {
    "maxStrength": 3,
    "mass": 2,
    "upperPush": 3,
    "neck": 3,
    "power": 3
   },
   "prehab": [
    "neck",
    "shoulderER"
   ],
   "note": "Your plan has the heaviest strength work, and your conditioning is 10-15 yd bursts from a stance."
  },
  {
   "id": "bigskill",
   "name": "Linebacker, tight end, fullback or running back",
   "desc": "Strength-power plus acceleration and change of direction, with a collision most plays.",
   "q": {
    "power": 3
   },
   "prehab": [
    "neck",
    "nordic"
   ],
   "note": "Your plan keeps the full strength work, and your conditioning is 15-25 yd drives with a cut."
  },
  {
   "id": "skill",
   "name": "Wide receiver or defensive back",
   "desc": "Top speed, change of direction and contested jumps, with less mass.",
