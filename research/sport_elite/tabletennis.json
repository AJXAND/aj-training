 "tests": [
  {
   "id": "sidestep",
   "name": "Side-step test",
   "how": "3 m lateral shuffles x 10, time it",
   "unit": "s",
   "better": "lower",
   "bands": {},
   "note": "Sparse norms. Track your own change."
  },
  {
   "id": "slbalance",
   "name": "Single-leg balance, eyes closed",
   "how": "Stand on one leg, eyes closed, up to 30 s. Each leg",
   "unit": "s",
   "better": "higher",
   "bands": {
    "good": "30"
   },
   "note": "Target is a full 30 s each side."
  },
  {
   "id": "mbasym",
   "name": "Rotational med ball throw asymmetry",
   "how": "Throw for distance from each side, best of 3, compare",
   "unit": "%",
   "better": "lower",
   "bands": {
    "good": "10-15",
    "elite": "<10"
   },
   "note": "Above 15% difference is a flag."
  },
  {
   "id": "sideplank",
   "name": "Side plank hold",
   "how": "Elbow and feet, straight line, hold to failure. Each side",
   "unit": "s",
   "better": "higher",
   "bands": {
    "good": "60+"
   }
  },
  {
   "id": "grip",
   "name": "Grip strength",
   "how": "Hand dynamometer, best of 3 each hand",
   "unit": "kg",
   "better": "higher",
   "bands": {},
   "note": "Track change over time."
  }
 ],
 "week": [
  "Low systemic fatigue: gym can go on most days.",
  "Leg session 48 h or more before a tournament.",
  "No gym the day before a tournament.",
  "Most weeks 2 sessions; 1 in heavy tournament weeks."
 ],
 "primer": [
  "2 x 3 lateral bounds each side",
  "Band shoulder external rotation 1-2 x 12",
  "A few multi-ball footwork reps"
 ],
 "taper": {
  "days": 4,
  "lines": [
   "Last strength session 3-4 days before a tournament.",
   "Primers only on match days.",
   "Keep shoulder band work daily."
  ]
 },
 "rules": [
  "Keep strength sessions to 35-45 min. Volume is deliberately modest.",
  "Train rotation on both sides, not just the forehand side.",
  "Rotational throw asymmetry above 15%: add sets on the weaker side."
 ],
