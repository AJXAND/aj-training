  "week": [
    "Race weekend: heavy legs on Monday or Tuesday, at least 72 h before racing",
    "Upper body and prehab mid-week",
    "Friday: rest or a short primer",
    "Track sessions: gate starts first, while fresh",
    "Nothing heavy for the legs within 48 h of a race"
  ],
  "primer": [
    "Easy spin and dynamic warm-up",
    "2 x 3 jumps or squat jumps",
    "2-3 gate starts or 5 s sprints, full rest",
    "1 set of band shoulder rotations"
  ],
  "taper": {
    "days": 10,
    "lines": [
      "Last heavy leg session 5-7 days out",
      "Cut gym volume by about half, keep the load",
      "Keep short gate starts and sprints sharp",
      "No new exercises in the last 2 weeks"
    ]
  },
  "rules": [
    "Full-face helmet and gloves for every track or park session",
    "Suspected concussion: stop riding and follow a graded return",
    "After a shoulder or collarbone injury, no pressing until cleared",
    "Under 18: supervised, technique first, follow youth training guidance",
    "No heavy legs within 48 h of a race"
  ],
