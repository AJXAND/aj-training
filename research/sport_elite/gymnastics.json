  {
   "id": "mag",
   "name": "Artistic (men's apparatus)",
   "desc": "Rings, pommel and bars put very high loads on the shoulders, wrists and elbows.",
   "q": {},
   "prehab": [
    "shoulderER",
    "scap",
    "wrist"
   ],
   "note": "Shoulder, scapular and wrist work move to the front of every session."
  },
  {
   "id": "wag",
   "name": "Artistic (women's apparatus)",
   "desc": "Floor, beam and vault put the load on landings; ACL risk is higher in women.",
   "q": {},
   "prehab": [
    "landing",
    "ankle",
    "wrist"
   ],
   "note": "Landing and ankle work come first; landing volume is managed."
  },
  {
   "id": "tumbling",
   "name": "Trampoline and tumbling",
   "desc": "Repeated take-offs and landings; the research applies only loosely here.",
   "q": {},
   "prehab": [
    "landing",
    "ankle",
    "lowback"
   ],
   "note": "Landing, ankle and back work lead; keep the same strength base."
  }
