      "id": "dinghy",
      "name": "Dinghy (hiking or trapeze)",
      "desc": "Minutes of near-isometric quad, hip flexor and trunk work while hiking, with short bursts of sheeting and tacks.",
      "q": {
        "lowerBody": 3
      },
      "prehab": [
        "patellar",
        "lowback"
      ],
      "note": "Your plan keeps hiking holds and leg strength at the front. Body mass helps righting moment, so hold or gain it if your class needs it."
    },
