    "grip": 3
   },
   "prehab": [
    "elbow",
    "wrist",
    "shoulderER",
    "trunkLat"
   ],
   "note": "Forearm, wrist and shoulder work twice a week; rotational work both sides."
  },
  {
   "id": "keeper",
   "name": "Wicketkeeper",
   "desc": "Hundreds of squats per innings and lateral dives; knee, hip and finger load.",
   "q": {
    "unilateral": 3,
    "lowerBody": 3
   },
   "prehab": [
    "copenhagen",
    "hipRot",
    "wrist"
   ],
