  "week": [
    "Surf when the waves are good; lift on flat days",
    "Off or flat season: 3 sessions; consistent swell: 1",
    "No heavy upper body before a long paddle session",
    "Keep cuff and scapular work in 2-3 times a week"
  ],
  "primer": [],
  "taper": {
    "days": 7,
    "lines": [
      "Last heavy session 5-7 days before a contest or trip",
      "Keep paddling volume, cut gym volume",
      "No new exercises in the last 2 weeks"
    ]
  },
  "rules": [
    "Cuff and scapular work 2-3 times a week",
    "Pulling sets at least equal to pressing sets",
    "Stop and get checked if shoulder pain lingers after paddling"
  ],
