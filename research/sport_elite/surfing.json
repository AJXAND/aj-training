  "conditioning": {
    "off": [
      {
        "name": "Paddle endurance",
        "mode": "swim",
        "work": "3-4 x 5 min",
        "rest": "1-2 min",
        "intensity": "Moderate to hard, steady",
        "perWeek": 2,
        "why": "Paddling is about half of heat time; SkiErg works on land"
      },
      {
        "name": "Repeated sprint paddle",
        "mode": "swim",
        "work": "10-15 x 15 s hard",
        "rest": "45 s easy",
        "intensity": "Near max, like chasing a wave",
        "perWeek": 1,
        "why": "Repeated sprints to catch waves (coach practice); SkiErg also works"
      }
    ],
    "pre": [
