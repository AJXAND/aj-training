 "conditioning": {
  "off": [],
  "pre": [
   {
    "name": "Arm pump circuit",
    "mode": "any",
    "work": "3-4 rounds: 40 s push-up hold, 40 s dead hang, 40 s squat hold",
    "rest": "2 min between rounds",
    "intensity": "Hard but controlled",
    "perWeek": 1,
    "why": "Gravity riders: grip and holding endurance for long descents. Coach practice."
   },
   {
    "name": "Run simulations",
    "mode": "bike",
    "work": "4-6 x 2-4 min",
    "rest": "Full recovery",
    "intensity": "Race effort",
    "perWeek": 1,
    "why": "Gravity riders: matches race run length. Coach practice."
   },
   {
    "name": "Over-threshold surges",
    "mode": "bike",
    "work": "Sets of 30 s on / 30 s off",
    "rest": "Easy spin between sets",
    "intensity": "Above threshold",
    "perWeek": 1,
    "why": "XC: repeated surges on climbs."
   }
  ],
  "in": [
   {
    "name": "Arm pump circuit",
    "mode": "any",
    "work": "3 rounds: 40 s push-up hold, 40 s dead hang, 40 s squat hold",
    "rest": "2 min between rounds",
    "intensity": "Hard but controlled",
    "perWeek": 1,
    "why": "Gravity riders: holds grip endurance. Coach practice."
   }
  ]
 },
 "tests": [
  {
   "id": "ftp",
   "name": "Functional threshold power",
   "how": "20 min all-out on a power meter or smart trainer, x 0.95.",
   "unit": "W/kg",
   "better": "higher",
   "bands": {
    "good": "3.5-4.0"
   },
   "note": "Good amateur XC. Gravity 3.0-3.5."
  },
  {
   "id": "squat1rm",
   "name": "Back squat 1RM",
   "how": "Estimate from a 3-5RM.",
   "unit": "x bodyweight",
   "better": "higher",
   "bands": {
    "good": "1.25"
   },
   "note": "Good amateur XC. Gravity 1.5."
  },
  {
   "id": "pullups",
   "name": "Max pull-ups",
   "how": "Dead hang start, chin over bar, no kip.",
   "unit": "reps",
   "better": "higher",
   "bands": {
    "good": "8"
   },
   "note": "Good amateur XC. Gravity 12."
  },
  {
   "id": "deadhang",
   "name": "Dead hang",
   "how": "Overhand grip on a bar, hang until you let go.",
   "unit": "s",
   "better": "higher",
   "bands": {
    "good": "45"
   },
   "note": "Good amateur XC. Gravity 60 s+."
  }
 ],
 "week": [
  "Lift on hard ride days, leaving easy days easy.",
  "Never heavy legs the day before key intervals or a race.",
  "Gravity riders: grip work after riding, never before.",
  "In season: one short session a week."
 ],
 "primer": [],
 "taper": {
  "days": 10,
  "lines": [
   "Ride volume down 40-60% over 7-14 days, keep short hard efforts.",
   "Last heavy lift 7-10 days out.",
   "No gym in race week.",
   "No new exercises in the final 2 weeks."
  ]
 },
 "rules": [
  "Crash injuries are not preventable in the gym: skills and protective gear first.",
  "Heavy, low-rep strength, not high-rep endurance lifting.",
  "Hand numbness or pump that will not settle: check brakes and suspension set-up.",
  "Knee pain: check bike fit first."
 ],
