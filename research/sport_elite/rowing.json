 "week": [
  "Heavy lifting after the morning row on a lower-intensity day.",
  "Or pair it with a hard session when the afternoon is off.",
  "No gym the day before a race or a 2 km test.",
  "Winter: circuit on a third day, away from key ergs."
 ],
 "primer": [
  "2-3 x 2 cleans or jumps",
  "One lift 2 x 2 at about 80%",
  "Once, 3-4 days before the race"
 ],
 "taper": {
  "days": 12,
  "lines": [
   "Water and erg volume down 40-60% over 10-14 days.",
   "Last heavy lift 7-10 days out.",
   "One primer 3-4 days out.",
   "No new exercises in the final 2 weeks."
  ]
 },
 "rules": [
  "Erg and water volume up no more than 10-15% a week (rib stress).",
  "Avoid long low-rate ergs and sudden volume jumps.",
  "Eat enough: low energy availability raises rib stress risk.",
  "Sweep rowers: single-side work on both sides on land.",
  "Lightweights: 0.5-1% body mass a week, no dehydration cuts.",
  "Rib pain on the stroke: stop and refer."
 ],
