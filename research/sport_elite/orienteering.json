  "taper": {
    "days": 10,
    "lines": [
      "Last heavy gym session 7 days out",
      "Running volume down 40-60%, keep some race-pace work",
      "Keep the ankle and balance work light",
      "No new exercises in the last 2 weeks"
    ]
  },
  "rules": [
    "Previous ankle sprain: balance work all year and consider a brace or tape for races",
    "Build running volume by no more than about 10% a week",
    "Shin pain that lingers after runs: cut volume and see a physio",
    "Strength is heavy and low-rep, not high-rep endurance lifting"
