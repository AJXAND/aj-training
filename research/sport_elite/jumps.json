  "group": "Track and field",
  "variants": [
    {
      "id": "long",
      "name": "Long jump",
      "desc": "Approach speed is the biggest single factor; one fast take-off.",
      "q": {},
      "prehab": [
        "nordic",
        "landing"
      ],
      "note": "Your plan puts hamstring protection first. Sprint work on the track matters most for you."
    },
    {
      "id": "triple",
      "name": "Triple jump",
      "desc": "The highest take-off forces of the jumps, three contacts in a row.",
      "q": {},
      "prehab": [
        "patellar",
        "calf"
      ],
      "note": "Your plan puts knee tendon and calf work first. Build hop-phase loading slowly to avoid heel bruising."
    },
    {
      "id": "high",
      "name": "High jump",
      "desc": "Curved approach and a single-leg take-off with back arching over the bar.",
      "q": {},
      "prehab": [
        "ankle",
        "lowback"
      ],
      "note": "Your plan adds single-leg vertical jumps and puts ankle and lower-back care first.",
      "add": [
        {
          "role": "pow",
          "ex": [
            "hopstick",
            "splitjump",
            "boxjp"
          ],
          "sets": {
            "new": 2,
            "inter": 3,
            "adv": 3
          },
          "reps": "3/side",
          "rir": 3,
          "note": "Jump up off one leg, stick the landing"
        }
      ]
    },
    {
      "id": "pole",
      "name": "Pole vault",
      "desc": "Sprint approach plus a big upper-body pull, swing and invert.",
      "q": {
        "upperPull": 3,
        "upperPush": 2,
        "grip": 2
      },
      "prehab": [
        "shoulderER",
        "lowback"
      ],
      "note": "Your plan adds weighted pull-ups (4 x 5) and rope climbs, and puts shoulder care first.",
      "add": [
        {
          "role": "main",
          "ex": [
            "wpullup",
            "pullup",
            "latpd"
          ],
          "sets": {
            "new": 3,
            "inter": 4,
            "adv": 4
          },
          "reps": "5",
          "rir": 2,
          "note": "Add weight once 10 strict reps are easy"
        },
        {
          "role": "acc",
          "ex": [
            "ropeclimb",
            "towelhang",
            "pullup"
          ],
          "sets": {
            "new": 2,
            "inter": 3,
            "adv": 3
          },
          "reps": "2-3",
          "rir": 2,
          "note": "Controlled, no dropping"
        }
      ]
    }
  ],
