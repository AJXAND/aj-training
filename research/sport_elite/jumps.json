  "tests": [
    {
      "id": "cmj",
      "name": "Countermovement jump",
      "how": "Hands on hips, jump app or jump-and-reach; best of 3",
      "unit": "cm",
      "better": "higher",
      "bands": {
        "club": "<50",
        "good": "50-65",
        "elite": "65+"
      },
      "note": "Women: good club 40 cm, elite 50 cm+"
    },
    {
      "id": "rsi",
      "name": "Reactive strength index",
      "how": "Drop jump from 30 cm; jump height / contact time (jump app)",
      "unit": "ratio",
      "better": "higher",
      "bands": {
        "club": "<2.0",
        "good": "2.0-2.5",
        "elite": "2.5+"
      }
    },
    {
      "id": "stj",
      "name": "Standing triple jump",
      "how": "Two-foot start, hop, step, jump into a pit; measure to the heel",
      "unit": "m",
      "better": "higher",
      "bands": {
        "club": "<8.0",
        "good": "8.0-9.0",
        "elite": "9.0+"
      },
      "note": "Women: good club 7.0 m, elite 8.0 m+"
    },
    {
      "id": "squat1rm",
      "name": "Back squat 1RM",
      "how": "Estimate from a 3 rep max; never within 10 days of competing",
      "unit": "x BM",
      "better": "higher",
      "bands": {
        "club": "<1.75",
        "good": "1.75-2.0",
        "elite": "2.0+"
      }
    },
    {
      "id": "sprint30",
      "name": "30 m sprint",
      "how": "3-point start, timing gates or phone slow-motion video",
      "unit": "s",
      "better": "lower",
      "bands": {
        "club": ">4.3",
        "good": "3.9-4.3",
        "elite": "<3.9"
      },
      "note": "As sprinters; women good club 4.8 s, elite 4.3 s"
    }
  ],
  "week": [
    "Gym follows the hardest track or jump session, never before it",
    "Count all take-offs and bounds across track and gym",
    "Full jump session that day: cut gym plyometrics",
    "Plyometric contacts: new 40-60, intermediate 60-100, advanced 80-140 per gym session",
    "Two peaks a year (indoor and outdoor) are normal"
  ],
  "primer": [
    "3-4 days out, gym primer only",
    "2 x 2 hang clean at 75%",
    "2 x 3 jumps",
    "1 set of 2 squats at 80%"
  ],
  "taper": {
    "days": 10,
    "lines": [
      "Last heavy session (90%) 7-10 days out",
      "Roughly halve take-off volume in the final 10 days",
      "Final week: volume down 40-50%, keep intensity",
      "No maxing within 10 days of competing"
    ]
  },
  "rules": [
    "Nordics all year: ramp up, then low-volume maintenance",
    "Count take-offs; knee tendon pain means cut jump volume, not just push on",
    "Patellar isometrics and heavy slow work if the knee tendon is sore",
    "Build triple jump hop-phase loading gradually",
    "Never lift heavy legs the day before competing"
  ],
