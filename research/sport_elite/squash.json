  {
   "id": "competitive",
   "name": "Competitive (league or ranked)",
   "desc": "Matches run at about 92% of max heart rate, so fitness limits you as much as strength.",
   "prehab": [
    "calf",
    "copenhagen"
   ],
   "note": "Fitness limits you as much as strength: aim for 2-3 conditioning sessions a week in a build block."
  },
  {
   "id": "over40",
   "name": "Recreational over 40",
   "desc": "Calf tears and Achilles ruptures cluster in players aged 30-50, and unfit older players carry more cardiac risk.",
   "prehab": [
    "calf",
    "ankle"
   ],
   "note": "Your plan adds extra calf and Achilles work. Build match frequency gradually and get any chest symptoms checked.",
   "add": [
    {
     "role": "pre",
     "ex": [
      "seatedcalf",
      "soleuswall",
      "seateddbcalf"
     ],
     "sets": {
      "new": 2,
      "inter": 3,
      "adv": 3
     },
     "reps": "12",
     "rir": 2,
     "note": "Slow lowering. Soleus and Achilles."
    }
   ]
  }
