 "conditioning": {
  "off": [
   {
    "name": "Aerobic base",
    "mode": "bike",
    "work": "30-45 min steady, or 4 x 4 min",
    "rest": "3 min easy between 4 min efforts",
    "intensity": "Steady: conversational. Intervals: 90-95% max heart rate",
    "perWeek": 1,
    "why": "Squash is the most aerobic racket sport, so the base comes first."
   },
   {
    "name": "Ghosting intervals",
    "mode": "court",
    "work": "10-20 s ghosting to the corners x 10-15, 3 sets",
    "rest": "10-20 s between reps, 3 min between sets",
    "intensity": "Match pace, recover to the T each time",
    "perWeek": 1,
    "why": "The standard squash method: it matches rally length and movement."
   }
  ],
  "pre": [
   {
    "name": "Ghosting intervals",
    "mode": "court",
    "work": "10-20 s on / 10-20 s off x 10-15, 3-4 sets; or 6 corners x 4-6 at 30 s on / 30 s off",
    "rest": "3 min between sets",
    "intensity": "Hard, near match pace",
    "perWeek": 2,
    "why": "Builds the repeated lunge and turn fitness squash rallies demand."
   },
   {
    "name": "Lunge clock",
    "mode": "court",
    "work": "Lunge to all four corners on a clock, 60 s on x 5",
    "rest": "60 s off",
    "intensity": "Hard but controlled lunges",
    "perWeek": 1,
    "why": "Repeated lunge endurance under fatigue."
   }
  ],
  "in": [
   {
    "name": "Ghosting intervals",
    "mode": "court",
    "work": "10-20 s on / 10-20 s off x 10, 2-3 sets",
    "rest": "3 min between sets",
    "intensity": "Match pace",
    "perWeek": 1,
    "why": "Keeps court fitness. Never the day before a match."
   }
  ]
 },
 "tests": [
  {
   "id": "vo2max",
   "name": "VO2max",
   "how": "Lab test, or track the squash ghosting test as a field proxy",
   "unit": "ml/kg/min",
   "better": "higher",
   "bands": {
    "club": "45-50",
    "good": "50-55",
    "elite": "55-64"
   },
   "note": "Professional women about 45-55."
  },
  {
   "id": "ghost",
   "name": "Squash ghosting test",
   "how": "Court-specific multistage ghosting test (Wilkinson). Log stages completed",
   "unit": "stages",
   "better": "higher",
   "bands": {},
   "note": "No published amateur bands. Track your own change."
  },
  {
   "id": "505",
   "name": "505 change of direction",
   "how": "10 m run-in, turn 180 degrees at 15 m, time the 5 m in and out. Both sides",
   "unit": "s",
   "better": "lower",
   "bands": {
    "club": "2.55",
    "good": "2.40",
    "elite": "<2.35"
   }
  },
  {
   "id": "cmj",
   "name": "Countermovement jump",
   "how": "Hands on hips, phone app such as My Jump, best of 3",
   "unit": "cm",
   "better": "higher",
   "bands": {
    "club": "30-35",
    "good": "35-40",
    "elite": ">40"
   }
  },
  {
   "id": "calfraise",
   "name": "Single-leg calf raise to fatigue",
   "how": "On a step, full range, 1 rep every 2 s, count clean reps. Each leg",
   "unit": "reps",
   "better": "higher",
   "bands": {
    "club": "25+",
    "good": "30+",
    "elite": "35+"
   },
   "note": "Coaching practice benchmark."
  }
 ],
 "week": [
  "League match evening: heavy lower 48 h or more before.",
  "No ghosting intervals the day before a match.",
  "Build block: gym 3 a week (alternate A and B), conditioning 2-3.",
  "Compete weeks: gym 2 short sessions, conditioning 1.",
  "Tournament on back-to-back days: primers only."
 ],
 "primer": [
  "2 x 3 lateral bounds each side",
  "2 x 3 jumps",
  "Band shoulder external rotation 1 x 12",
  "A few match-pace ghosting reps"
 ],
 "taper": {
  "days": 7,
  "lines": [
   "Cut conditioning volume by about half.",
   "Keep ghosting at high intensity in short sets.",
   "Last heavy lower 4 days before.",
   "Primer on match day."
  ]
 },
 "rules": [
  "Protective eyewear: compulsory for juniors and doubles, advised for everyone.",
  "Over 40 and unfit: build match frequency gradually and get chest pain or unusual breathlessness checked.",
  "Over 35-40: calf and Achilles work every week, all year.",
  "New lifters: no split jumps or drop jumps. Low-amplitude plyos only.",
  "Train rotation and single-leg work on both sides."
 ],
