 "variants": [
  {
   "id": "shot",
   "name": "Shot put",
   "desc": "Heaviest implement; body mass, leg drive and pressing strength matter most.",
   "q": {},
   "prehab": [
    "wrist",
    "shoulderER"
   ],
   "note": "Bench and push press stay the priority; wrist work is added twice a week."
  },
  {
   "id": "discus",
   "name": "Discus",
   "desc": "Rotational throw with a long release path; trunk rotation and hip separation matter.",
   "q": {},
   "prehab": [
    "tspine",
    "lowback",
    "hipRot"
   ],
   "note": "Rotational med ball and thoracic rotation work move to the front."
  },
  {
   "id": "hammer",
   "name": "Hammer",
   "desc": "Multiple turns against a heavy pulling implement; the low back and trunk take high loads.",
   "q": {},
   "prehab": [
    "lowback",
    "trunkLat"
   ],
   "note": "Back endurance and anti-rotation core come first in prehab."
  },
  {
   "id": "javelin",
   "name": "Javelin",
   "desc": "Run-up and overhead throw; less body mass, high shoulder and medial elbow stress.",
   "q": {
    "upperPush": 2,
    "mass": 1
   },
   "prehab": [
    "shoulderER",
    "scap",
    "elbow",
    "nordic"
   ],
   "note": "Bench becomes incline DB or landmine press, Nordics are added and throw volume is managed."
  }
 ],
