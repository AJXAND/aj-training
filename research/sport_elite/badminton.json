   "better": "higher",
   "bands": {
    "club": "45-50",
    "good": "50-55",
    "elite": ">55"
   },
   "note": "Adult men. Women about 15% lower."
  },
  {
   "id": "footwork",
   "name": "Badminton footwork test",
   "how": "Six-point or four-corner shadow test, 3 rounds, time it",
   "unit": "s",
   "better": "lower",
   "bands": {},
   "note": "No published bands. Track your own change."
  },
  {
   "id": "cmj",
   "name": "Countermovement jump",
   "how": "Hands on hips, phone app such as My Jump, best of 3",
   "unit": "cm",
   "better": "higher",
   "bands": {
    "club": "32-38",
    "good": "38-45",
    "elite": ">45"
   },
   "note": "Adult men. Women lower."
  },
  {
   "id": "505",
   "name": "505 change of direction",
   "how": "10 m run-in, turn 180 degrees, time the 5 m in and out. Both sides",
   "unit": "s",
   "better": "lower",
   "bands": {
    "club": "2.50",
    "good": "2.40",
    "elite": "<2.30"
   },
   "note": "Adult men. Women about 10% slower."
  },
  {
   "id": "calfraise",
