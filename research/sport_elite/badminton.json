{
 "id": "badminton",
 "name": "Badminton",
 "aliases": [
  "shuttlecock",
  "badders"
 ],
 "group": "Racket",
 "variants": [
  {
   "id": "singles",
   "name": "Singles",
   "desc": "Most court coverage: aerobic power and repeated lunges matter most.",
   "note": "Your footwork intervals are 10 s on, 20 s off, and the aerobic session stays in."
  },
  {
   "id": "doubles",
   "name": "Doubles",
   "desc": "More front-back rotation, smashes and drives, with shorter rallies.",
   "prehab": [
    "shoulderER"
   ],
   "note": "Your footwork intervals are shorter, 6-8 s on and 15 s off, and your plan adds extra smash-pattern med ball throws.",
   "add": [
    {
     "role": "pow",
     "ex": [
      "mbslam",
      "mbohthrow",
      "mbchest"
     ],
     "sets": {
      "new": 2,
      "inter": 2,
      "adv": 3
     },
     "reps": "4",
     "rir": 3,
     "note": "Smash pattern, max intent."
    }
   ]
  },
  {
   "id": "over35",
   "name": "Recreational over 35",
   "desc": "Badminton is one of the leading sports for Achilles ruptures in northern Europe.",
   "prehab": [
    "calf",
    "ankle"
   ],
   "note": "Your plan adds extra calf and Achilles work. Progress your jumps more slowly than younger players.",
   "add": [
    {
     "role": "pre",
     "ex": [
      "seatedcalf",
      "soleuswall",
      "seateddbcalf"
     ],
     "sets": {
      "new": 2,
      "inter": 3,
      "adv": 3
     },
     "reps": "12",
     "rir": 2,
     "note": "Slow lowering. Soleus and Achilles."
    }
   ]
  }
 ],
