 "week": [
  "Mon: acceleration on the track, then heavy lower gym",
  "Tue: tempo running, no gym",
  "Wed: max velocity or speed endurance, then power gym",
  "Thu: off or tempo",
  "Fri: acceleration or event work, then light power (off and pre)",
  "Sat: speed endurance; Sun: off"
 ],
 "primer": [
  "3-4 days out, gym primer only",
  "2 x 2 hang clean at 75%",
  "2 x 3 jumps",
  "1 set of 2 squats at 80%"
 ],
 "taper": {
  "days": 10,
  "lines": [
   "Last heavy session (90%) 7-10 days out",
   "Last high-volume track session 10-12 days out",
   "Final week: volume down 40-50%, keep intensity",
   "Keep short accelerations and a few flying runs",
   "No maxing within 10 days of the race"
  ]
 },
 "rules": [
  "Nordics all year: ramp up, then low-volume maintenance",
  "Track quality first: gym follows the hard track session",
  "Build high-speed running and spike work gradually",
  "Repeated bone or tendon pain with low energy intake: get screened for REDs",
  "Never lift heavy legs the day before a race"
 ],
