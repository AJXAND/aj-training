   "better": "higher",
   "bands": {
    "club": "12-13",
    "good": "14-17",
    "elite": "18+"
   },
   "note": "Bands for ages 60-69. Under 12 needs work."
  },
  {
   "id": "slstand",
   "name": "Single-leg stand, eyes open",
   "how": "Hands on hips, time until the foot moves or touches down. Each leg",
   "unit": "s",
   "better": "higher",
   "bands": {
    "club": "10-20",
    "good": "20-30",
    "elite": ">30"
   },
   "note": "Under 10 s needs work."
  },
  {
   "id": "calfraise",
   "name": "Single-leg calf raise to fatigue",
   "how": "Full range, hand on a wall, count clean reps. Each leg",
   "unit": "reps",
   "better": "higher",
   "bands": {
    "club": "15-20",
    "good": "20-25",
    "elite": ">25"
   },
   "note": "Under 15 needs work."
  },
  {
   "id": "grip",
   "name": "Grip strength",
   "how": "Hand dynamometer, best of 3, stronger hand",
   "unit": "kg",
   "better": "higher",
   "bands": {
    "club": "30-35",
    "good": "35-45",
    "elite": ">45"
   },
   "note": "Men shown. Women: needs work under 20, good 22-26, excellent over 28."
  },
  {
   "id": "5105",
   "name": "5-10-5 shuttle",
   "how": "Start in the middle, 5 m one way, 10 m back, 5 m to finish",
   "unit": "s",
   "better": "lower",
   "bands": {},
   "note": "Track your own change."
  }
 ],
 "week": [
  "Default 2 gym sessions a week; 3 in a build block.",
  "No heavy lower within 24-48 h of a tournament.",
  "Social play can follow a gym session the same day.",
  "Heavy tournament weeks: 1-2 short sessions."
 ],
 "primer": [
  "Warm-up before every match: 5 min easy movement",
  "Balance holds 2 x 20 s each leg",
  "Band shoulder external rotation 1 x 15",
  "A few lateral steps and sticks"
 ],
 "taper": {
  "days": 3,
  "lines": [
   "Last heavy session 3 days before a tournament.",
   "Day before: balance and shoulder prep only.",
   "Warm up before every match."
  ]
 },
 "rules": [
  "Turn and run back for lobs. Do not backpedal: it causes many falls.",
  "Older beginners: power work is fast intent, low amplitude only.",
  "Low hops for bone health only if appropriate for you.",
  "Lift heavy enough to load bone: the last reps of a set should feel hard."
 ],
 "sources": [
