  {
   "id": "over55",
   "name": "Older adult (55+)",
   "desc": "Most injured players are over 60, often from falls and backpedalling for lobs.",
   "prehab": [
    "ankle",
    "calf"
   ],
   "note": "Pick this if you are over 55. Your plan leads with balance, leg strength and bone loading. Turn and run for lobs, never backpedal."
  },
  {
   "id": "younger",
   "name": "Younger competitive player",
   "desc": "Faster, more powerful play closer to tennis demands.",
   "q": {
    "power": 2,
    "maxStrength": 2
   },
   "prehab": [
    "shoulderER",
    "elbow"
   ],
   "note": "Your plan adds extra lateral power, shoulder and elbow work.",
   "add": [
    {
     "role": "pow",
