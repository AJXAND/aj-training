 "week": [
  "Pair gym with technical days, not sparring days.",
  "Lift after practice, or at least 6 h apart.",
  "Day before hard sparring: no heavy legs and no high-volume grip work.",
  "Off camp gym 3 a week; camp 2-3; peak week 1 primer.",
  "Last hard sparring 7-14 days before the fight."
 ],
 "primer": [
  "3 x 2 jumps",
  "3 x 3 med ball throws",
  "2 x 2 at 70-75% on one lift",
  "Neck isometrics"
 ],
 "taper": {
  "days": 10,
  "lines": [
   "Last heavy session 7-10 days out.",
   "Fight week: one primer early in the week, then rest.",
   "Prehab drops to one short session.",
   "Align the peak with any weight plan: low-residue eating needs no extra training."
  ]
 },
 "rules": [
  "Neck work every week, all year, 2-3 times (1-2 in the peak week).",
  "No neck bridging for amateurs.",
  "Under 18, pregnant, or a concussion history: conservative defaults and get medical clearance.",
  "Gym conditioning only where sport practice does not already provide it.",
  "No new exercises in the last 2 weeks and no max testing within 10 days of a bout.",
  "Professional weight cuts are not a template for amateurs.",
  "Hard sparring once a week or less is common in good gyms (practice).",
  "1-2 weeks after a fight: medical checks, mobility and light work only.",
  "Weight loss to reach a class: 0.5-1% of body mass a week, protein 1.8-2.2 g/kg, keep lifting.",
