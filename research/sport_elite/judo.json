 "week": [
  "Randori is the hard day: lift heavy after randori or on technical days.",
  "Never lift heavy the day before hard randori.",
  "Heavy lift at least 6 h after judo, or after it in one block.",
  "Keep easy days easy."
 ],
 "primer": [
  "Hang clean: 3 x 1 at 75%",
  "Med ball throws: 2 x 3",
  "Gi pull-ups: 2 x 3",
  "Short, sharp uchikomi"
 ],
 "taper": {
  "days": 10,
  "lines": [
   "Last heavy session 7-10 days out.",
   "One primer 3-4 days out.",
   "Uchikomi stays sharp but short.",
   "IJF weighs in the evening before, with a random morning check at 5% over."
  ]
 },
 "rules": [
  "Neck work every week, all year, 2-3x (1-2x in the peak week).",
  "No neck bridging for amateurs.",
  "No heavy or high-volume lifting the day before hard sparring or competition.",
  "No dehydration cuts for amateurs; none at all for under-18s or same-day weigh-ins.",
  "Flag any plan for more than 5% acute weight loss.",
  "Chronic weight loss: 0.5-1% of body mass a week, strength work kept in.",
  "Last heavy lift 7-10 days out; no new exercises in the final 2 weeks.",
  "No max testing within 10 days of a competition.",
  "Gym conditioning only if mat or ring work does not already cover it.",
  "Good ukemi is the main shoulder protection: drill break-falls.",
  "Tap early to armlocks."
 ],
