 "conditioning": {
  "off": [
   {
    "name": "Aerobic base",
    "mode": "any",
    "work": "30-40 min",
    "rest": "none",
    "intensity": "Zone 2, can hold a conversation",
    "perWeek": 2,
    "why": "Aerobic fitness speeds recovery between rounds and matches."
   }
  ],
  "pre": [
   {
    "name": "Match simulation",
    "mode": "any",
    "work": "4-6 rounds of your belt's match length (5-10 min)",
    "rest": "1-2 min",
    "intensity": "Match pace; fresh partner each minute in the last 3 weeks",
    "perWeek": 1,
    "why": "Only if you roll hard fewer than 3x a week."
   },
   {
    "name": "Gym grappling circuit",
    "mode": "any",
    "work": "3-4 x 6 min: 20 s sled, rope pull or air bike, then 40 s grip hold or carry",
    "rest": "2 min",
    "intensity": "Hard but repeatable",
    "perWeek": 1,
    "why": "Mimics bursts inside long grip holds when mat time is short."
   }
  ],
