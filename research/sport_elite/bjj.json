  {
   "id": "gi",
   "name": "Gi",
   "desc": "Cloth grips make grip and finger endurance the classic limiter.",
   "q": {},
   "prehab": [
    "fingers"
   ],
   "note": "Grip work stays in every session; swap pull-ups for strapped pulldowns after hard gi days."
  },
  {
   "id": "nogi",
   "name": "No-gi",
   "desc": "Faster scrambles and wrist and body locks; less finger load, more heel hook risk to knees.",
   "q": {
    "power": 3
   },
   "prehab": [
    "landing",
    "copenhagen"
   ],
   "note": "More jumps and knee and groin work; finger hangs can drop to one set."
  }
 ],
