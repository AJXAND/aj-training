   "bands": {
    "elite": "50-60"
   },
   "note": "Elite men's range. Track your own trend per hand."
  }
 ],
 "week": [
  "Gym on drilling or lighter class days.",
  "Never lift hard the day before the hardest open mat.",
  "Heavy lift after class, or at least 6 h apart.",
  "Rolled hard in the gi? Swap grip-heavy pulls for strapped pulldowns.",
  "Keep easy days easy."
 ],
 "primer": [
  "Jumps: 2 x 3",
  "One lower lift: 2 x 3 at 80%",
  "One upper pull: 2 x 3 at 80%",
  "Neck holds: 1 x 10 s each way"
 ],
 "taper": {
  "days": 14,
  "lines": [
   "Drop to 1 short gym session in the final 1-2 weeks.",
   "That session: 2 x 3 at 80% on one lower and one upper lift, jumps, neck.",
   "Last hard rolls 5-7 days out.",
   "IBJJF weighs in just before your first match, in the gi: no acute cut."
  ]
 },
 "rules": [
  "Neck work every week, all year, 2-3x (1-2x in the peak week).",
  "No neck bridging for amateurs.",
  "No heavy or high-volume lifting the day before hard sparring or competition.",
  "No dehydration cuts for amateurs; none at all for under-18s or same-day weigh-ins.",
  "Flag any plan for more than 5% acute weight loss.",
  "Chronic weight loss: 0.5-1% of body mass a week, strength work kept in.",
  "Last heavy lift 7-10 days out; no new exercises in the final 2 weeks.",
  "No max testing within 10 days of a competition.",
  "Gym conditioning only if mat or ring work does not already cover it.",
  "Tap early: no exercise protects a locked armbar or heel hook.",
  "Buddy tape sore fingers; vary grips."
 ],
