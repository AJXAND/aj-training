 "conditioning": {
  "off": [
   {
    "name": "Aerobic base",
    "mode": "bike",
    "work": "20-30 min",
    "rest": "none",
    "intensity": "steady, conversational",
    "perWeek": 2,
    "why": "Dancers' aerobic fitness is often only moderate and responds to extra work."
   }
  ],
  "pre": [
   {
    "name": "Dance intervals",
    "mode": "any",
    "work": "4-6 x 2-3 min of choreography",
    "rest": "1-2 min",
    "intensity": "performance intensity",
    "perWeek": 1,
    "why": "Matches the demands of long sections on stage; coach practice."
   }
  ],
  "in": []
 },
 "tests": [
  {
   "id": "slcalf",
   "name": "Single-leg calf raise reps",
   "how": "Full range on a step, to a metronome, each side",
   "unit": "reps",
   "better": "higher",
   "bands": {
    "good": "25+"
   },
   "note": "Coach practice."
  },
  {
   "id": "hopsym",
   "name": "Single-leg hop symmetry",
   "how": "Best single hop each leg; weaker as % of stronger",
   "unit": "%",
   "better": "higher",
   "bands": {
    "good": "90+"
   },
   "note": "Coach practice."
  },
  {
   "id": "cmj",
   "name": "Countermovement jump",
   "how": "Hands on hips, best of 3",
   "unit": "cm",
   "better": "higher",
   "bands": {},
   "note": "Track your own trend."
  },
  {
   "id": "ybal",
   "name": "Y-balance anterior reach difference",
   "how": "Reach forward on one leg, compare sides",
   "unit": "cm",
   "better": "lower",
   "bands": {
    "good": "<4"
   },
   "note": "Coach practice."
  },
  {
   "id": "daft",
   "name": "Dance Aerobic Fitness Test",
   "how": "Use the DAFT if you can access it",
   "unit": "stage",
   "better": "higher",
   "bands": {},
   "note": "Optional aerobic check."
  }
 ],
 "week": [
  "Gym at the end of the day or on lighter rehearsal days",
  "Keep sessions to 30-45 min and low fatigue",
  "No heavy legs the day before a performance or audition",
  "Performance season with 6-8 shows a week: 1-2 short sessions"
 ],
 "primer": [],
 "taper": {
  "days": 7,
  "lines": [
   "Last hard gym session 5-7 days before a premiere or audition",
   "Keep prehab going",
   "No new exercises in the final 2 weeks"
  ]
 },
 "rules": [
  "Never force turnout in the gym",
  "Foot pain that builds with jumping: check for stress fracture and low energy",
  "Strength work does not harm flexibility when dosed sensibly; keep it in",
  "Under-18s follow youth resistance-training rules"
 ],
 "sources": [
  {
   "source": "Koutedakis & Jamurtas 2004, Sports Medicine"
  },
  {
   "source": "Allen et al. 2012, Journal of Orthopaedic and Sports Physical Therapy"
  },
  {
   "source": "Liederbach, Dilgen & Rose 2008, American Journal of Sports Medicine"
  },
  {
   "source": "Angioi et al. 2009, Medical Problems of Performing Artists"
  }
 ],
