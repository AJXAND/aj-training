 "variants": [
  {
   "id": "ballet",
   "name": "Ballet",
   "desc": "Work on demi-pointe and pointe puts heavy load on the foot, ankle and calf; turnout loads the hip.",
   "q": {},
   "prehab": [
    "calf",
    "ankle",
    "hipRot"
   ],
   "note": "Calf raises go through full demi-pointe range and hip rotation work is never forced."
  },
  {
   "id": "partnering",
   "name": "Partnering and lifts",
   "desc": "Lifting a partner adds upper-body and low back load.",
   "q": {
    "upperPull": 2,
    "upperPush": 2
   },
   "prehab": [
    "lowback",
    "shoulderER"
   ],
   "note": "More pulling and pressing, with back endurance work moved up."
  }
 ],
 "sessions": {
  "off": [
   {
    "name": "Day A: squat, split squat, calves",
    "focus": "Leg strength, jump power and calf capacity",
    "slots": [
     {
      "role": "pow",
      "ex": [
       "pogo",
       "skipping",
       "cmj"
      ],
      "sets": {
       "new": 2,
       "inter": 3,
       "adv": 3
      },
      "reps": "10",
      "rir": 3,
      "note": "Light, stiff ankles."
     },
     {
      "role": "pow",
      "ex": [
       "boxjp",
       "cmj",
