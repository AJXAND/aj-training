      ],
      "sets": {
       "new": 2,
       "inter": 3,
       "adv": 3
      },
      "reps": "4",
      "rir": 3,
      "note": "Land softly, step down."
     },
     {
      "role": "main",
      "ex": [
       "goblet",
       "frontsq",
       "dbfrontsq",
       "squat"
      ],
      "sets": {
       "new": 3,
       "inter": 4,
       "adv": 4
      },
      "reps": "6",
      "rir": 2
     },
     {
      "role": "main",
      "ex": [
       "bss",
       "dbsplit",
       "bwss",
       "ffesplit"
      ],
      "sets": {
       "new": 2,
       "inter": 3,
       "adv": 3
      },
      "reps": "6-8/side",
      "rir": 2
     },
     {
      "role": "acc",
      "ex": [
       "slcalf",
       "stepcalf",
       "standcalf",
       "seatedcalf"
      ],
      "sets": {
       "new": 2,
       "inter": 3,
       "adv": 3
      },
      "reps": "10-15/side",
      "rir": 2,
      "note": "Through full demi-pointe range, slow."
     },
     {
      "role": "pre",
      "ex": [
       "slbalance",
       "hopstick"
      ],
      "sets": {
       "new": 2,
       "inter": 2,
       "adv": 3
      },
      "reps": "30-45 s/side",
      "rir": 3
     },
     {
      "role": "pre",
      "ex": [
       "9090",
