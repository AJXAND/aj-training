 "variants": [
  {
   "id": "frontrow",
   "name": "Front row (props, hooker)",
   "desc": "Scrummaging needs maximal lower-body, trunk and neck strength, plus body mass. Lowest aerobic volume.",
   "q": {
    "maxStrength": 3,
    "neck": 3,
    "mass": 2,
    "grip": 3
   },
   "prehab": [
    "neck"
   ],
   "note": "Adds scrum isometric holds 4 x 6-8 s, trap bar shrugs 3 x 8 and extra neck work."
  },
  {
   "id": "lock",
   "name": "Second row (locks)",
   "desc": "Lineout jumping and lifting plus mauls: vertical power and overhead strength.",
   "q": {
    "power": 3,
    "upperPush": 3
   },
   "prehab": [
    "landing",
    "shoulderER"
   ],
   "note": "Adds push press, overhead holds and split-stance jumps 3 x 3 for lineouts."
  },
  {
   "id": "backrow",
   "name": "Back row (6, 7, 8)",
   "desc": "Most tackles and breakdown work: strength plus repeated efforts and aerobic power.",
   "q": {},
   "prehab": [
    "neck",
    "shoulderER"
   ],
   "note": "Keeps the full strength plan and more repeated-effort conditioning."
  },
  {
   "id": "halfback",
   "name": "Half-backs (9, 10)",
   "desc": "Most distance among backs; acceleration, kicking and passing. Less need for mass.",
   "q": {
    "mass": 1
   },
   "prehab": [
    "hipFlex",
    "nordic"
   ],
   "note": "Less mass work, more aerobic intervals and acceleration; adds hip flexor work for kicking."
  },
  {
   "id": "centre",
   "name": "Centres (12, 13)",
   "desc": "Collisions plus acceleration: strength-power, upper body and neck.",
   "q": {
    "upperPush": 3
   },
   "prehab": [
    "neck",
    "shoulderER"
   ],
   "note": "Full upper-body strength plan with neck and shoulder work kept at the front."
  },
  {
   "id": "backthree",
   "name": "Back three (11, 14, 15)",
   "desc": "Top speed and aerial contests: sprinting, hamstrings, jumping and landing.",
   "q": {
    "unilateral": 3,
    "mass": 1
   },
   "prehab": [
    "nordic",
    "landing"
   ],
   "note": "Swaps one upper accessory for max-velocity sprints and single-leg plyos; Nordics come first."
  },
  {
   "id": "sevens",
   "name": "Sevens",
   "desc": "Tournament rugby: several matches a day, more open running and top-speed work per player.",
   "q": {
    "mass": 1
   },
   "prehab": [
    "nordic",
    "landing"
   ],
   "note": "Tournament weeks are no gym except a primer; train like a back three player otherwise (practice)."
  }
