 "avoidBefore": "lower",
 "energy": "800 m is about two-thirds aerobic and 1500 m about 80-85% aerobic, and both need a big gap between top speed and VO2max speed.",
 "summary": "Middle distance needs a big aerobic engine, top-end speed, and calves, tendons and bones that cope with high mileage. The plan uses heavy and explosive lifting twice a week to improve running economy without adding bulk, plus calf, hamstring and shin protection.",
 "evidence": [
  {
   "claim": "Heavy and explosive strength training improves running economy and middle- and long-distance performance without harming endurance.",
   "source": "Blagrove, Howatson & Hayes 2018, Sports Medicine",
   "url": "https://repository.lboro.ac.uk/articles/journal_contribution/Effects_of_strength_training_on_the_physiological_determinants_of_middle-_and_long-distance_running_performance_a_systematic_review/9619553"
  },
  {
   "claim": "World-class distance runners do about 80% of their running at low intensity, with structured threshold and VO2max sessions.",
   "source": "Haugen et al. 2022, Sports Medicine Open",
   "url": "https://munin.uit.no/handle/10037/26245"
  }
 ],
