  "group": "Other",
  "variants": [
    {
      "id": "dressage",
      "name": "Dressage",
      "desc": "Sustained postural control, isometric trunk strength and left-right symmetry.",
      "q": {},
      "prehab": [
        "lowback",
        "hipRot",
        "tspine"
      ],
      "note": "Your plan puts trunk, hip and upper-back mobility work first. You do not need the interval sessions."
    },
    {
      "id": "showjumping",
      "name": "Show jumping",
      "desc": "Short 60-90 s rounds with repeated squat-like jumping-position holds.",
      "q": {},
      "prehab": [
        "copenhagen",
        "hipAbd"
      ],
      "note": "Your plan includes jumping-position holds from pre-season and puts adductor and hip work first."
    },
    {
      "id": "eventing",
      "name": "Eventing",
      "desc": "Cross-country is 6-12 min at speed in a jumping position at high heart rates.",
      "q": {},
      "prehab": [
        "lowback",
        "copenhagen"
      ],
      "note": "Your plan adds cross-country intervals (3-4 x 3-4 min) in pre-season and short intervals in season. Use the 2 km row test to track your fitness."
    }
  ],
