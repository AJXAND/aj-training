 "tests": [
  {
   "id": "chs",
   "name": "Driver clubhead speed",
   "how": "Launch monitor, best of 5 full drives after warm-up.",
   "unit": "mph",
   "better": "higher",
   "bands": {
    "club": "90-95",
    "good": "105-110",
    "elite": "115+"
   },
   "note": "Women: amateur about 70-80, tour about 94-96. Industry data, not peer reviewed."
  },
  {
   "id": "mbrotasym",
   "name": "Rotational med ball throw, each side",
   "how": "3 kg ball, side-on throw for distance, best of 3 each way.",
   "unit": "% difference",
   "better": "lower",
   "bands": {
    "club": ">10",
    "good": "<10",
    "elite": "<10"
   },
   "note": "Keep left and right within 10%."
  },
  {
   "id": "cmj",
   "name": "Countermovement jump",
   "how": "Hands on hips, jump app or jump mat, best of 3.",
   "unit": "cm",
   "better": "higher",
   "bands": {
    "club": "<40",
    "good": "40+"
   },
   "note": "Women: 30 cm is a good amateur target."
  },
  {
   "id": "trapdl1rm",
   "name": "Trap bar deadlift 1RM",
   "how": "Work up to a hard single, or estimate from a 3-5RM.",
   "unit": "x BM",
   "better": "higher",
   "bands": {
    "club": "<1.5",
    "good": "1.5+"
   }
  },
  {
   "id": "rotscreen",
   "name": "Rotation screen",
   "how": "Seated trunk rotation about 45 degrees each way; 90/90 hip IR about 35-45 degrees; deep squat; toe touch.",
   "unit": "pass/fail",
   "better": "higher",
   "bands": {
    "club": "fail 2+",
    "good": "fail 1",
    "elite": "pass all"
   },
   "note": "TPI-style screen, coach practice."
  }
 ],
