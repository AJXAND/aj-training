   {
    "name": "Bout simulation",
    "mode": "any",
    "work": "2 x 3 min with 30 s break; each 3 min = 3 x (10 s max shots or sprawls, 50 s live) (folkstyle: 3-2-2 min periods)",
    "rest": "3-5 min, repeat 3-4 times",
    "intensity": "Bout pace",
    "perWeek": 1,
    "why": "Rehearses a tournament day of repeated glycolytic bouts."
   },
